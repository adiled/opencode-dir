{
  "name": "opencode-dir",
  "version": "1.1.0",
  "description": "Directory operations for opencode sessions",
  "type": "module",
  "license": "MIT",
  "main": "index.ts",
  "exports": {
    "./server": "./index.ts",
    "./tui": "./dist/tui.tsx"
  },
  "files": [
    "index.ts",
    "lib.ts",
    "db.ts",
    "dist/"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "rm -rf dist && mkdir -p dist && cp tui.tsx dist/tui.tsx",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cd",
    "mv",
    "add-dir",
    "directory",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adiled/opencode-dir.git"
  },
  "homepage": "https://github.com/adiled/opencode-dir#readme",
  "bugs": {
    "url": "https://github.com/adiled/opencode-dir/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=1.4.3"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
